#!/bin/bash

# This captures arguments, preserving quotes, so they can be forwarded to another shell.
# See: https://stackoverflow.com/a/8723305
C=''
for i in "$@"; do
    i="${i//\\/\\\\}"
    C="$C \"${i//\"/\\\"}\""
done

docker_run_flags=''
if [ -t 1 ]; then
	# Got tty
	docker_run_flags='-it'
fi

# renovate: datasource=docker depName=docker.io/composer
composer_image=docker.io/composer:2.10.3

docker run \
	$docker_run_flags \
	--rm \
	-e UID=`id -u` \
	-e GID=`id -g` \
	--mount type=bind,src=`pwd`/var/composer-cache,dst=/cache \
	--mount type=bind,src=`pwd`,dst=/app \
	--tmpfs=/home/user \
	--entrypoint=/bin/sh \
	"$composer_image" -c \
	"/bin/sh /app/etc/services/composer/init.sh && su -l user -c 'cd /app/app; COMPOSER_CACHE_DIR=/cache/composer composer $C'"
